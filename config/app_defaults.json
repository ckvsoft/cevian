{
    "app": {
        "debug": false,
        "css_js_debug": false,
        "hash_key": null,
        "controller_default": "home",
        "locale": "de_DE"
    },
    "paths": {
        "base_uri": "/",
        "modules_uri": "modules/",
        "core_modules_uri": "core_modules/",
        "albums_relative_path": "public/albums/"
    },
    "php_settings": {
        "error_reporting": "E_ALL",
        "display_errors": 0,
        "display_startup_errors": 0,
        "log_errors": 1,
        "error_log_path": "/var/log/error.log"
    },
    "session": {
        "timeout": 1800
    },
    "assets": {
        "css": {
            "default": ["/inc/css/style.css"],
            "mobile": ["/inc/css/mobile.css"]
        },
        "js": [
            "/inc/js/ajax-list-pagination.min.js",
            "/inc/js/cevian.min.js",
            "/inc/js/x-notify.min.js",
            "/inc/js/theme-js-vanilla.min.js"
        ]
    },
    "mail": {
        "smtp": {
            "host":       "",
            "port":       587,
            "encryption": "tls",
            "user":       "user_name",
            "pass":       "_Passw0rd!_",
            "timeout":    10,
            "ssl": {
                "verify_peer":        false,
                "verify_peer_name":   false,
                "allow_self_signed":  true
            }
        }
    }
}
