AddDefaultCharset UTF-8

RewriteEngine On

RewriteBase /cevian/

RewriteCond %{HTTPS} off
# First rewrite to HTTPS:
# Don't put www. here. If it is already there it will be included, if not
# the subsequent rule will catch it.
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Now, rewrite any request to the wrong domain to use www.
RewriteCond %{HTTP_HOST} !^service\.
RewriteRule .* https://service.%{HTTP_HOST}%{REQUEST_URI} [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d


# QSA is CRITICAL here: without it the original query string is
# dropped by this rewrite (e.g. ?key=<token> of the rspamd map
# endpoints never reaches $_GET).
RewriteRule ^(.+)$ index.php?uri=$1 [B,QSA,L]
