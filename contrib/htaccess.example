# ============================================================================
# cevian — Wurzel-.htaccess VORLAGE (Beispiel)
# ----------------------------------------------------------------------------
# Diese Datei wird NICHT versioniert (git-ignored: /.htaccess) und der
# Framework-Installer legt sie auch nicht an (er zeigt nur einen Hinweis,
# die RewriteBase auf den BASE_URI der Site zu setzen).
#
# Vorgehen pro SITE: diese Vorlage nach <site-docroot>/.htaccess kopieren
# und an die Site anpassen:
#
#   - RewriteBase:     auf den BASE_URI der Site (z. B. /cevian/ oder /)
#   - QRK-Hatches:     NUR übernehmen, wenn die Site die qrkupdates-
#                      Endpoints über dieses URL-Schema bedient
#                      (z. B. service.ckvsoft.at/cevian/qrkupdates/...)
#   - https-/Domain-Umleitung: an die Gegebenheiten der Site anpassen
#
# Hinweis: Die QRK-(Qt)-Update-Clients rufen die Endpoints über PLAIN http
# auf und folgen KEINEN 301-Redirects — die Hatches unten halten genau
# diese Pfade vom https-Zwang ausgenommen. QSA am $1-Rewrite ist zwingend
# (rspamd-map-Endpoints brauchen ?key= durch bis zu $_GET).
#
# Stand: 2026-09-18 QRK-Form (frühere Commits 183a96d / 8891b34).
# ============================================================================
AddDefaultCharset UTF-8

RewriteEngine On

RewriteBase /cevian/

# Emergency hatch for the QRK (Qt) update flow: legacy clients fetch
# the update endpoints over PLAIN http and do NOT follow 301
# redirects -- they render the redirect body instead, so the update
# dialog shows "301 Moved Permanently" instead of the release notes.
# Two shapes must stay exempt from the https-enforcement below:
#   - /cevian/qrkupdates/(feed|relnotes|download|version|mobile...)
#   - index.php?uri=qrkupdates/...   (legacy client syntax)
#   - the /qrk/updates/* tree (qrk updates/.htaccess rewrites them
#     into this tree)
# Exempt them from the https-enforcement below, otherwise the update dialog shows
RewriteCond %{REQUEST_URI} qrkupdates/(feed|relnotes|download|version|mobile|mobileuiversion) [OR]
RewriteCond %{QUERY_STRING} uri=(/cevian/)?qrkupdates/(feed|relnotes|download|version|mobile|mobileuiversion) [OR]
RewriteCond %{REQUEST_URI} ^/qrk/updates/
RewriteCond %{HTTPS} off
# First rewrite to HTTPS (skipped for the QRK endpoints above):
RewriteRule .* - [S=1]
RewriteCond %{HTTPS} off
# Don't put www. here. If it is already there it will be included, if not
# the subsequent rule will catch it.
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Now, rewrite any request to the wrong domain to use www.
RewriteCond %{HTTP_HOST} !^service\.
RewriteRule .* https://service.%{HTTP_HOST}%{REQUEST_URI} [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# QSA is CRITICAL here: without it the original query string is
# dropped by this rewrite (e.g. ?key=<token> of the rspamd map
# endpoints never reaches $_GET).
RewriteRule ^(.+)$ index.php?uri=$1 [B,QSA,L]